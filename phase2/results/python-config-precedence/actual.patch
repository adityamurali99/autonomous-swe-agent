+import unittest
+from app.config import load_settings
+import os
+
+class TestPrecedence(unittest.TestCase):
+    def test_environment_overrides_file(self) -> None:
+        # SERVICE_TIMEOUT should override file setting
+        # file has timeout: 20
+        # set environment SERVICE_TIMEOUT to 30
+        environ = {"SERVICE_TIMEOUT": "30"}
+        settings = load_settings("settings.json", environ)
+        self.assertEqual(settings.timeout, 30)
+
+if __name__ == "__main__":
+    unittest.main()
